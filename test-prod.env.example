# Production-like test configuration. This file is safe to commit because it
# contains names and non-secret flags only; never place credentials here.
AI_PROVIDER=openai
AUTH_ENFORCEMENT_ENABLED=true
CRON_SECRET=
ENABLE_DASHBOARD_WRITE_CONTROLS=false
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NX_DAEMON=false
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ROUTING_MODE_YBA=
TELEGRAM_WEBHOOK_SECRET=
TURBO_CACHE=local:
TURBO_DOWNLOAD_LOCAL_ENABLED=true
TURBO_REMOTE_ONLY=false
TURBO_RUN_SUMMARY=false
VERCEL=1
VERCEL_ENV=production
VERCEL_GIT_COMMIT_AUTHOR_LOGIN=
VERCEL_GIT_COMMIT_AUTHOR_NAME=
VERCEL_GIT_COMMIT_MESSAGE=
VERCEL_GIT_COMMIT_REF=
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_PREVIOUS_SHA=
VERCEL_GIT_PROVIDER=
VERCEL_GIT_PULL_REQUEST_ID=
VERCEL_GIT_REPO_ID=
VERCEL_GIT_REPO_OWNER=
VERCEL_GIT_REPO_SLUG=
VERCEL_OIDC_TOKEN=
VERCEL_TARGET_ENV=production
VERCEL_URL=
opspilot_cron_secret=
opspilot_followup_cycle_url=
